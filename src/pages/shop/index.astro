---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import UpitForm from '../../components/UpitForm.astro';
import ProductCard from '../../components/ProductCard.astro';
import type { Product } from '../../components/ProductCard.astro';
import products from '../../data/products.json';

const all = products as Product[];

// Sort: featured first, then category, then name (CLAUDE.md §6).
const order = ['Monitori', 'Periferija', 'Laptop oprema', 'Tableti', 'Komponente', 'Softver i licence'];
const sorted = [...all].sort(
  (a, b) =>
    Number(b.featured) - Number(a.featured) ||
    order.indexOf(a.category) - order.indexOf(b.category) ||
    a.name.localeCompare(b.name, 'sr'),
);

const categories = [...new Set([...order, ...all.map(p => p.category)])].filter((c) => all.some((p) => p.category === c));

const title = 'Oprema za firme — monitori, periferija i dodaci | Easy Computers';
const description =
  'Monitori, periferija, laptop oprema i licence za mala preduzeća. Cene sa PDV-om. Dostupnost, cenu i rok isporuke potvrđujemo uz ponudu.';
---

<Base title={title} description={description}>
  <Nav />

  <main id="main">
    <section class="pt-12 md:pt-16">
      <div class="mx-auto max-w-site px-5 md:px-8">
        <h1 class="text-h1 font-bold">Oprema</h1>
        <p class="mt-5 max-w-[62ch] text-lead text-steel">
          Ono što najčešće isporučujemo firmama. Nema korpe — pošaljite upit i javljamo se sa
          ponudom, predračunom i rokom isporuke.
        </p>

        <!-- Disclaimer strip (CLAUDE.md §6) -->
        <div class="mt-8 rounded-card border border-line border-l-2 border-l-accent bg-surface p-4">
          <p class="text-meta text-steel">
            Cene se menjaju sa kursom i lagerom dobavljača — svaku potvrđujemo uz ponudu. Za
            pravna lica: predračun i plaćanje po dogovoru.
          </p>
        </div>
      </div>
    </section>

    <!-- Filter + search -->
    <section id="shop-filters" aria-label="Filteri opreme" class="sticky top-[60px] z-30 mt-10 border-y border-line bg-paper">
      <div class="mx-auto max-w-site px-5 py-3 md:px-8">
        <div class="grid items-center gap-3 xl:grid-cols-[minmax(0,1fr)_200px]">
          <div class="flex min-w-0 items-center gap-2 overflow-x-auto pb-1" aria-label="Kategorije">
          <button
            type="button"
            aria-pressed="true"
            class="chip is-active min-h-11 rounded-card border border-line px-3.5 py-1.5 text-meta font-semibold transition-colors"
            data-filter="*">Sve</button
          >
          {
            categories.map((category) => (
              <button
                type="button"
                aria-pressed="false"
                class="chip min-h-11 rounded-card border border-line px-3.5 py-1.5 text-meta font-semibold transition-colors"
                data-filter={category}
              >
                {category}
              </button>
            ))
          }

          </div>
          <label class="w-full" for="shop-search">
            <span class="sr-only">Pretraga opreme</span>
            <input
              type="search"
              id="shop-search"
              placeholder="Pretraga…"
              autocomplete="off"
              class="w-full rounded-card border border-line bg-surface px-3.5 py-1.5 text-meta transition-colors focus:border-accent"
            />
          </label>
        </div>

        <p class="mt-2 text-meta text-steel" id="shop-count" aria-live="polite">
          Prikazano {sorted.length} od {sorted.length} proizvoda
        </p>
      </div>
    </section>

    <!-- Grid -->
    <section aria-label="Katalog proizvoda" class="py-8 md:pb-16">
      <div class="mx-auto max-w-site px-5 md:px-8">
        <h2 class="sr-only">Katalog opreme i licenci</h2>
        <div id="shop-grid" class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {sorted.map((product) => <ProductCard product={product} />)}
        </div>

        <p id="shop-empty" class="hidden py-16 text-center text-steel">
          Ništa ne odgovara pretrazi. Probajte drugi pojam ili nas pozovite — nabavljamo i ono
          što nije na sajtu.
        </p>
        <nav id="shop-pagination" aria-label="Stranice kataloga" class="mt-8 hidden items-center justify-between gap-3 border-t border-line pt-6">
          <button id="shop-prev" type="button" class="min-h-11 rounded-card border border-line px-4 py-2 text-meta font-semibold disabled:opacity-40">Prethodna</button>
          <span id="shop-page" class="text-center text-meta text-steel"></span>
          <button id="shop-next" type="button" class="min-h-11 rounded-card border border-line px-4 py-2 text-meta font-semibold disabled:opacity-40">Sledeća</button>
        </nav>
      </div>
    </section>

    <!-- Upit -->
    <section id="upit" class="border-t border-line bg-surface section-y">
      <div class="mx-auto grid max-w-site gap-12 px-5 md:px-8 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <h2 class="text-h2 font-medium">Pošaljite upit</h2>
          <p class="mt-4 max-w-[58ch] text-steel">
            Napišite šta vam treba i u kojoj količini — javljamo se sa ponudom i rokom isporuke.
          </p>

          <p
            id="upit-selected"
            class="mt-5 hidden items-center gap-3 rounded-card border border-line bg-paper p-3 text-meta"
          >
            <span class="dot flex-none"></span>
            <span>Upit za: <strong id="upit-selected-name"></strong></span>
            <button
              type="button"
              id="upit-clear"
              class="ml-auto font-semibold text-accent hover:underline">Poništi</button
            >
          </p>

          <div class="mt-6">
            <UpitForm />
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="rounded-plan border border-line bg-paper p-6">
            <h3>Za pravna lica</h3>
            <ul class="mt-4 space-y-3 text-meta text-steel">
              <li class="flex gap-3"><span class="dot mt-2 flex-none"></span>Predračun i plaćanje po dogovoru.</li>
              <li class="flex gap-3"><span class="dot mt-2 flex-none"></span>Cene potvrđujemo uz ponudu — kurs i lager se menjaju.</li>
              <li class="flex gap-3"><span class="dot mt-2 flex-none"></span>Uz ugovor o održavanju imate popust 3–7% na svu opremu.</li>
              <li class="flex gap-3"><span class="dot mt-2 flex-none"></span>Nabavljamo i ono što nije na sajtu — pitajte.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .chip.is-active {
    background-color: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-surface);
  }
  .chip {
    flex-shrink: 0;
    white-space: nowrap;
  }
</style>

<script>

  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-product]'));
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip'));
  const search = document.getElementById('shop-search') as HTMLInputElement | null;
  const count = document.getElementById('shop-count');
  const empty = document.getElementById('shop-empty');

  let category = '*';
  let page = 1;
  const pageSize = 12;
  const pagination = document.getElementById('shop-pagination');
  const previous = document.getElementById('shop-prev') as HTMLButtonElement | null;
  const next = document.getElementById('shop-next') as HTMLButtonElement | null;
  const pageLabel = document.getElementById('shop-page');
  const normalize = (value: string) => value.toLowerCase().replace(/đ/g, 'dj').normalize('NFD').replace(/[\u0300-\u036f]/g, '');

  function apply() {
    const term = normalize((search?.value ?? '').trim());
    let shown = 0;

    for (const card of cards) {
      const matchesCategory = category === '*' || card.dataset.category === category;
      const matchesTerm = !term || normalize(card.dataset.search ?? '').includes(term);
      const matches = matchesCategory && matchesTerm;
      if (matches) shown += 1;
      const visible = matches && shown > (page - 1) * pageSize && shown <= page * pageSize;
      // Inline style, not the `hidden` attribute or a `hidden` class: the cards
      // carry `flex`, and an author display utility beats both the UA
      // `[hidden] { display: none }` rule and an equal-specificity class.
      card.style.display = visible ? '' : 'none';
    }

    if (count) count.textContent = shown ? `Prikazano ${(page - 1) * pageSize + 1}–${Math.min(page * pageSize, shown)} od ${shown} proizvoda` : 'Nema proizvoda za ovu pretragu';
    empty?.classList.toggle('hidden', shown > 0);
    pagination?.classList.toggle('hidden', shown <= pageSize);
    pagination?.classList.toggle('flex', shown > pageSize);
    if (previous) previous.disabled = page === 1;
    if (next) next.disabled = page * pageSize >= shown;
    if (pageLabel) pageLabel.textContent = `Strana ${page} / ${Math.max(1, Math.ceil(shown / pageSize))}`;
  }

  for (const chip of chips) {
    chip.addEventListener('click', () => {
      category = chip.dataset.filter ?? '*';
      page = 1;
      for (const other of chips) {
        other.classList.toggle('is-active', other === chip);
        other.setAttribute('aria-pressed', String(other === chip));
      }
      apply();
    });
  }

  search?.addEventListener('input', () => { page = 1; apply(); });
  function changePage(delta: number) {
    page += delta;
    apply();
    document.getElementById('shop-grid')?.scrollIntoView({ block: 'start' });
  }
  previous?.addEventListener('click', () => changePage(-1));
  next?.addEventListener('click', () => changePage(1));
  const filters = document.getElementById('shop-filters');
  if (filters && 'ResizeObserver' in window) {
    new ResizeObserver(() => {
      document.documentElement.style.setProperty('--shop-offset', `${filters.offsetHeight + 84}px`);
    }).observe(filters);
  }

  // "Pošaljite upit" on a card: fill the hidden field, show what was picked,
  // then scroll to the form. Plain DOM, no modal.
  const proizvod = document.getElementById('upit-proizvod') as HTMLInputElement | null;
  const selected = document.getElementById('upit-selected');
  const selectedName = document.getElementById('upit-selected-name');
  const clear = document.getElementById('upit-clear');

  document.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLElement>('[data-upit]');
    if (!button) return;

    const name = button.dataset.upit ?? '';
    if (proizvod) proizvod.value = name;
    if (selectedName) selectedName.textContent = name;
    selected?.classList.remove('hidden');
    selected?.classList.add('flex');

    document.getElementById('upit')?.scrollIntoView({ block: 'start' });
    (document.getElementById('ime') as HTMLInputElement | null)?.focus({ preventScroll: true });
  });

  clear?.addEventListener('click', () => {
    if (proizvod) proizvod.value = '';
    selected?.classList.add('hidden');
    selected?.classList.remove('flex');
  });

  apply();
</script>
