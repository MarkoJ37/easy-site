---
import { formatRsd } from '../data/site';

export interface Product {
  id: string;
  slug: string;
  name: string;
  category: string;
  brand: string;
  short_desc: string;
  specs: string[];
  price_rsd: number | null;
  price_note: string | null;
  image: string | null;
  availability: string;
  featured: boolean;
  supplier_sku: string | null;
  auto_price: boolean;
}

interface Props {
  product: Product;
}

const { product } = Astro.props;

// Everything the client-side search matches against, lowercased once at build.
const haystack = [product.name, product.brand, product.short_desc, ...product.specs]
  .join(' ')
  .toLowerCase();
---

<article
  class="group flex min-w-0 flex-col rounded-plan border border-line bg-surface p-4 transition-colors hover:border-accent"
  data-product
  data-category={product.category}
  data-search={haystack}
>
  {/* No photos at launch — a typographic field, never a grey broken-image box. */}
  <div
    class="flex h-24 items-center justify-between gap-4 rounded-card border border-line bg-paper px-4"
  >
    {
      product.image ? (
        <img
          src={product.image}
          alt={product.name}
          loading="lazy"
          class="max-h-24 w-auto object-contain"
        />
      ) : (
        <span class="min-w-0 break-words font-display text-lead font-medium tracking-wide text-ink">
          {product.brand}
        </span>
      )
    }
    {!product.image && <span class="max-w-24 text-right text-eyebrow text-steel">{product.category}</span>}
  </div>

  {
    product.featured && (
      <p class="mt-4 flex items-center gap-2 text-eyebrow font-semibold uppercase text-steel">
        <span class="dot" />
        izdvojeno
      </p>
    )
  }

  <h3 class:list={[product.featured ? 'mt-2' : 'mt-4', 'break-words']}>{product.name}</h3>

  <p class="mt-2 text-meta text-steel">{product.short_desc}</p>

  {
    product.specs.length > 0 && (
      <ul class="mt-3 space-y-1">
        {product.specs.map((spec) => (
          <li class="text-meta text-steel">· {spec}</li>
        ))}
      </ul>
    )
  }

  <div class="mt-auto pt-5">
    {
      product.price_rsd !== null ? (
        <p class="font-display text-[1.5rem] font-medium tabular-nums">
          {formatRsd(product.price_rsd)} RSD
          <span class="ml-1 font-sans text-meta font-normal text-steel">sa PDV-om</span>
        </p>
      ) : (
        <p class="font-display text-[1.5rem] font-medium">{product.price_note ?? 'Cena na upit'}</p>
      )
    }

    <p class="mt-2 flex items-start gap-2 text-meta text-steel">
      <span class="dot mt-2 flex-none"></span>
      <span>{product.availability}</span>
    </p>

    <button
      type="button"
      class="btn btn-sm btn-secondary mt-4 w-full"
      data-upit={product.name}
    >
      Pošaljite upit
    </button>
  </div>
</article>
