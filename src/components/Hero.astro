---
/**
 * The right column is an abstract office-network diagram, not a photo and not
 * stock art — CLAUDE.md §0 asks for a graphic treatment where no photo exists.
 * The four trust facts live only in TrustBar now; they used to be duplicated here.
 */

// Bottom row of endpoint devices: x position and whether it shows a live dot.
const endpoints = [
  { x: 28, live: true },
  { x: 118, live: false },
  { x: 218, live: true },
  { x: 308, live: false },
];
---

<section class="relative overflow-hidden">
  <div class="bg-dotgrid pointer-events-none absolute inset-0" aria-hidden="true"></div>

  <div class="relative mx-auto grid max-w-site items-center gap-10 px-5 section-y md:px-8 lg:grid-cols-12 lg:gap-14">
    <div class="lg:col-span-7">
      <p class="flex items-center gap-2 text-eyebrow font-semibold uppercase text-steel">
        <span class="dot dot--pulse"></span>
        IT partner za mala preduzeća
      </p>

      <h1 class="mt-5 text-h1 font-bold">Računari, mreža i licence — da jednostavno rade.</h1>

      <p class="mt-6 max-w-[56ch] text-lead text-steel">
        IT oprema i podrška za mala preduzeća. Jedan partner, predvidiv mesečni trošak, bez
        komplikacija — u Beogradu i remote, širom Srbije.
      </p>

      <div class="mt-9 flex flex-wrap gap-3">
        <a
          href="#kontakt"
          class="rounded-card bg-accent px-6 py-3.5 font-semibold text-surface shadow-sm transition-all hover:-translate-y-0.5 hover:bg-ink hover:shadow-md"
        >
          Zakažite besplatan pregled
</a>
        <a
          href="/shop"
          class="rounded-card border border-line bg-surface px-6 py-3.5 font-semibold transition-all hover:-translate-y-0.5 hover:border-accent hover:text-accent"
        >
          Pogledajte opremu
        </a>
      </div>
    </div>

    <div class="lg:col-span-5">
      <svg
        viewBox="0 0 400 330"
        class="w-full max-w-[420px] lg:max-w-none"
        fill="none"
        aria-hidden="true"
      >
        <!-- connections -->
        <g stroke="var(--color-ink)" stroke-opacity="0.18" stroke-width="1.5" stroke-linecap="round">
          <path d="M200 74 V138" />
          <path d="M200 178 V206" />
          <path d="M60 206 H340" />
          {endpoints.map((e) => <path d={`M${e.x + 32} 206 V246`} />)}
        </g>

        <!-- traffic: the same spine, drawn again in green and animated -->
        <g stroke="var(--color-signal)" stroke-width="1.5" stroke-linecap="round">
          <path class="flow" d="M200 74 V138" />
          <path class="flow" d="M200 178 V206" style="animation-delay:-0.7s" />
          <path class="flow" d="M60 206 H340" style="animation-delay:-1.4s" />
        </g>

        <!-- router -->
        <rect x="164" y="30" width="72" height="44" rx="9"
              fill="var(--color-ink)" />
        <g stroke="var(--color-surface)" stroke-width="1.6" stroke-linecap="round" opacity="0.85">
          <path d="M186 58 h28" />
          <path d="M193 46 a10 10 0 0 1 14 0" />
          <path d="M188 40 a18 18 0 0 1 24 0" />
        </g>

        <!-- switch -->
        <rect x="164" y="138" width="72" height="40" rx="9"
              fill="var(--color-surface)" stroke="var(--color-ink)" stroke-opacity="0.28" stroke-width="1.5" />
        <g fill="var(--color-ink)" fill-opacity="0.3">
          <rect x="176" y="152" width="10" height="4" rx="2" />
          <rect x="192" y="152" width="10" height="4" rx="2" />
          <rect x="208" y="152" width="10" height="4" rx="2" />
          <rect x="176" y="162" width="10" height="4" rx="2" />
          <rect x="192" y="162" width="10" height="4" rx="2" />
        </g>
        <circle cx="224" cy="150" r="3.5" fill="var(--color-signal)" class="node-live" />

        <!-- endpoints -->
        {
          endpoints.map((e, i) => (
            <>
              <rect
                x={e.x}
                y={246}
                width="64"
                height="48"
                rx="9"
                fill="var(--color-surface)"
                stroke="var(--color-ink)"
                stroke-opacity="0.28"
                stroke-width="1.5"
              />
              <rect
                x={e.x + 12}
                y={258}
                width="40"
                height="20"
                rx="3"
                fill="var(--color-ink)"
                fill-opacity="0.12"
              />
              <path
                d={`M${e.x + 22} 286 h20`}
                stroke="var(--color-ink)"
                stroke-opacity="0.28"
                stroke-width="1.5"
                stroke-linecap="round"
              />
              {e.live && (
                <circle
                  cx={e.x + 54}
                  cy={252}
                  r="4"
                  fill="var(--color-signal)"
                  class="node-live"
                  style={`animation-delay:-${i * 0.6}s`}
                />
              )}
            </>
          ))
        }
      </svg>
    </div>
  </div>
</section>
