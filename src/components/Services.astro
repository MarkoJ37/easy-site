---
/** Copy verbatim from CLAUDE.md §5.3. Icons are lucide, 20px, stroke 1.75. */
const services = [
  {
    title: 'Održavanje i podrška',
    desc: 'Remote i na terenu. Mi brinemo o računarima, vi o poslu.',
    paths: [
      'M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z',
    ],
  },
  {
    title: 'Nabavka opreme',
    desc: 'Laptopovi, računari, monitori i periferija — po veleprodajnim uslovima, sa garancijom i našom podrškom.',
    paths: [
      'm7.5 4.27 9 5.15',
      'M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z',
      'm3.3 7 8.7 5 8.7-5',
      'M12 22V12',
    ],
  },
  {
    title: 'Prelazak na Windows 11',
    desc: 'Proveravamo koje mašine mogu na Windows 11, selimo podatke i menjamo ono što se ne isplati krpiti.',
    paths: [
      'M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8',
      'M21 3v5h-5',
      'M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16',
      'M8 16H3v5',
    ],
  },
  {
    title: 'Microsoft 365 i licence',
    desc: 'Email na vašem domenu, Office i Teams — legalno, podešeno i održavano.',
    paths: [
      'M22 7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2z',
      'm22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7',
    ],
  },
  {
    title: 'Backup i zaštita podataka',
    desc: 'Automatski backup na NAS i u cloud. Da jedan pokvaren disk ne postane katastrofa.',
    paths: [
      'M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z',
      'm9 12 2 2 4-4',
    ],
  },
  {
    title: 'Mreže i Wi-Fi',
    desc: 'Stabilna mreža u kancelariji, magacinu i lokalu — projektovanje, oprema i održavanje.',
    paths: [
      'M12 20h.01',
      'M2 8.82a15 15 0 0 1 20 0',
      'M5 12.859a10 10 0 0 1 14 0',
      'M8.5 16.429a5 5 0 0 1 7 0',
    ],
  },
];
---

<section id="usluge" class="section-y bg-surface border-y border-line">
  <div class="mx-auto max-w-site px-5 md:px-8" data-reveal>
    <h2 class="text-h2 font-medium">Šta radimo za vas</h2>

    <!-- Rule-separated rows, not boxed cards — DESIGN-NOTES §6.2 -->
    <ul class="mt-10 grid gap-x-10 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((s) => (
          <li class="group border-t border-line py-6 transition-colors hover:border-signal">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-accent"
              aria-hidden="true"
            >
              {s.paths.map((d) => (
                <path d={d} />
              ))}
            </svg>
            <h3 class="mt-3">{s.title}</h3>
            <p class="mt-1.5 text-meta text-steel">{s.desc}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
