---
import { site, legalLine } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="bg-ink text-surface">
  <div class="mx-auto max-w-site px-5 py-12 md:px-8">
    <div class="flex flex-wrap items-start justify-between gap-8">
      <div>
        <p class="text-lead font-semibold">{site.brand}</p>
        <p class="mt-2 text-meta text-surface/70">{legalLine}</p>
      </div>

      <nav aria-label="Dodatni linkovi">
        <ul class="space-y-2 text-meta">
          <li><a class="hover:underline" href="/shop">Oprema</a></li>
          <li><a class="hover:underline" href="/privatnost">Privatnost</a></li>
          <li><a class="hover:underline" href={site.telHref}>{site.tel}</a></li>
          <li><a class="hover:underline" href={site.emailHref}>{site.email}</a></li>
        </ul>
      </nav>
    </div>

    <div class="mt-10 flex items-center gap-2 border-t border-white/10 pt-6 text-meta text-surface/60">
      <span class="dot opacity-60"></span>
      <span>© {year} {site.legalName}</span>
    </div>
  </div>
</footer>
