---
import { site } from '../data/site';

interface Props {
  /** Prefills the hidden `proizvod` field when opened from a /shop card. */
  proizvod?: string;
}

const { proizvod = '' } = Astro.props;

/**
 * Build-time fallback for the time-trap. JS overwrites it on load with the real
 * render time — without that this would be the *build* timestamp, which is hours
 * or days old and would let every submission sail past `time() - ts > 3`.
 * Leaving the fallback in means no-JS visitors can still submit; they simply
 * don't get the trap.
 */
const buildTs = Math.floor(Date.now() / 1000);

const counts = ['1–5', '6–10', '11–20', '20+', 'nije bitno'];

const field =
  'mt-1.5 w-full rounded-card border border-line bg-surface px-3.5 py-2.5 text-body ' +
  'outline-none transition-colors focus:border-accent';
const label = 'block text-meta font-semibold';
---

<form id="upit-form" action="/api/upit.php" method="post" class="grid gap-4 sm:grid-cols-2">
  <div>
    <label class={label} for="ime">Ime i prezime <span class="text-signal-ink">*</span></label>
    <input class={field} type="text" id="ime" name="ime" required autocomplete="name" />
  </div>

  <div>
    <label class={label} for="firma">Firma</label>
    <input class={field} type="text" id="firma" name="firma" autocomplete="organization" />
  </div>

  <div>
    <label class={label} for="telefon">Telefon <span class="text-signal-ink">*</span></label>
    <input class={field} type="tel" id="telefon" name="telefon" required autocomplete="tel" />
  </div>

  <div>
    <label class={label} for="email">Email</label>
    <input class={field} type="email" id="email" name="email" autocomplete="email" />
  </div>

  <div class="sm:col-span-2">
    <label class={label} for="racunari">Broj računara</label>
    <select class={field} id="racunari" name="racunari">
      {counts.map((c) => <option value={c}>{c}</option>)}
    </select>
  </div>

  <div class="sm:col-span-2">
    <label class={label} for="poruka">Poruka <span class="text-signal-ink">*</span></label>
    <textarea class={field} id="poruka" name="poruka" rows="4" required></textarea>
  </div>

  <input type="hidden" name="proizvod" id="upit-proizvod" value={proizvod} />
  <input type="hidden" name="ts" id="upit-ts" value={buildTs} />

  <!-- Honeypot. Hidden from sight and from assistive tech; bots fill it, people can't. -->
  <div class="absolute left-[-9999px] h-0 w-0 overflow-hidden" aria-hidden="true">
    <label for="website">Website</label>
    <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
  </div>

  <div class="sm:col-span-2">
    <button
      type="submit"
      id="upit-submit"
      class="w-full rounded-card bg-accent px-6 py-3.5 font-semibold text-surface transition-colors hover:bg-ink disabled:opacity-60"
    >
      Pošaljite upit
    </button>

    <p
      id="upit-error"
      class="mt-3 hidden text-meta text-signal-ink"
      role="alert"
      aria-live="polite"
    >
      Nešto nije prošlo. Pozovite nas ili pišite na {site.email}.
    </p>

    <p class="mt-3 text-meta text-steel">
      Javljamo se u roku od jednog radnog dana. Polja označena <span class="text-signal-ink">*</span> su obavezna.
    </p>
  </div>
</form>

<script>
  const form = document.getElementById('upit-form') as HTMLFormElement | null;
  const ts = document.getElementById('upit-ts') as HTMLInputElement | null;
  const error = document.getElementById('upit-error');
  const submit = document.getElementById('upit-submit') as HTMLButtonElement | null;

  // Real render time, so the server's time-trap measures the visitor's dwell.
  if (ts) ts.value = String(Math.floor(Date.now() / 1000));

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;

    error?.classList.add('hidden');
    if (submit) {
      submit.disabled = true;
      submit.textContent = 'Šaljemo…';
    }

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (!res.ok) throw new Error(String(res.status));
      window.location.href = '/hvala';
    } catch {
      // The visitor's text is never cleared — they can retry or copy it out.
      error?.classList.remove('hidden');
      if (submit) {
        submit.disabled = false;
        submit.textContent = 'Pošaljite upit';
      }
    }
  });
</script>
