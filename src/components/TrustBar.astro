---
/**
 * The single home for the four trust facts, in the navy treatment Marko picked
 * over the white band. Full-bleed so it reads as a band, not a floating card.
 */
const facts = [
  'Od 1999. godine',
  'Oprema i podrška na jednom mestu',
  'Odziv istog radnog dana',
  'Beograd + remote, cela Srbija',
];
---

<section class="bg-ink text-surface" aria-label="Zašto Easy Computers">
  <ul class="mx-auto grid max-w-site px-5 md:px-8 sm:grid-cols-2 lg:grid-cols-4">
    {
      facts.map((fact) => (
        <li
          class="flex items-center gap-3 border-t border-white/10 py-5 lg:border-t-0 lg:border-l lg:py-6 lg:pl-6 lg:first:border-l-0 lg:first:pl-0"
        >
          <span class="dot" />
          <span class="text-meta font-semibold">{fact}</span>
        </li>
      ))
    }
  </ul>
</section>
